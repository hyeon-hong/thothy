generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(uuid())
  email     String      @unique
  name      String
  picture   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  agents    UserAgent[]
}

model Agent {
  id          String      @id @default(uuid())
  name        String
  description String
  imageUrl    String?
  code        String      @default("")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  users       UserAgent[]
}

model UserAgent {
  id        String   @id @default(uuid())
  userId    String
  agentId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  agent     Agent    @relation(fields: [agentId], references: [id])

  @@unique([userId, agentId])
} 