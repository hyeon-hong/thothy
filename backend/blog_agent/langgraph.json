{
  "dependencies": [
    "."
  ],
  "graphs": {
    "blog_graph": "./src/blog_graph/graph.py:graph"
  },
  "auth": {
    "path": "../security/auth.py:auth",
    "disable_studio_auth": false
  },
  "env": "../../.env",
  "python_version": "3.12",
  "module": "blog_graph.graph",
  "class": "BlogGraph",
  "config": {
    "module": "blog_graph.configuration",
    "class": "BlogConfiguration"
  },
  "api": {
    "module": ".langgraph_api.api",
    "class": "BlogAPI"
  }
}