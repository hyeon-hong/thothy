  "scripts": {
    "clean": "npm run clean:root && npm run clean:frontend && npm run clean:backend && npm run clean:packages",
    "clean:root": "rm -rf ./node_modules ./.turbo ./yarn.lock",
    "clean:frontend": "rm -rf ./frontend/node_modules ./frontend/.next",
    "clean:backend": "rm -rf ./backend/plan_agent/dist ./backend/plan_agent/node_modules ./backend/data_agent/dist ./backend/data_agent/node_modules",
    "clean:packages": "rm -rf ./packages/evals/dist ./packages/evals/node_modules ./packages/shared/dist ./packages/shared/node_modules",
    "dev": "npx @langchain/langgraph-cli dev --config ./langgraph.json",
    "build": "turbo build",
    "turbo:command": "turbo",
    "format": "turbo format",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix"
  },
