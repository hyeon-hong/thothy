    "./backend/news_agent",
    "./backend/open_deep_research_agent",
    "./backend/research_agent",
    "./backend/security",
    "./backend/team_agent"
  ],
  "graphs": {
    "blog_graph": "./backend/blog_agent/src/blog_graph/graph.py:graph",
